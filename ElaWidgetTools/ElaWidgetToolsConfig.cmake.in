@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# 消费项目同样要求 Qt 6.12.0 及以上，不锁定到 6.12 系列。
find_dependency(Qt6 6.12.0 COMPONENTS Widgets)
# 静态库的链接接口需要传递私有依赖；动态库消费者无需 Qt 私有头文件。
if(@ELAWIDGETTOOLS_BUILD_STATIC_LIB@)
    find_dependency(Qt6 6.12.0 COMPONENTS WidgetsPrivate)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ElaWidgetToolsTargets.cmake")
check_required_components(ElaWidgetTools)
